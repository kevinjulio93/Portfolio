---
import { personalInfo } from "../data/portfolio";
---

<section
  id="contact"
  class="relative cta-cloud-mist px-5 sm:px-9 md:px-14 py-24 sm:py-32 text-center overflow-hidden"
>
  <div class="relative z-10 max-w-[780px] mx-auto">
    <!-- Elevated Status Pill (Exact Match to Video 00:15-00:16) -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white dark:bg-[#18181b] border border-black/[0.06] dark:border-white/[0.1] shadow-[0_8px_24px_rgba(0,0,0,0.06)] text-[12.5px] font-medium tracking-[-0.01em] text-[#18181b] dark:text-[#f4f4f5]">
      <span class="w-2 h-2 rounded-full bg-[#22c55e]" />
      <span data-i18n="contact.available">Available for New Project</span>
    </div>

    <!-- Giant Editorial Headline (Exact Match to Video 00:16) -->
    <h2
      class="mt-6 font-display text-[clamp(2.2rem,5.8vw,4.4rem)] font-semibold tracking-[-0.035em] text-[#18181b] dark:text-white uppercase leading-[1.02]"
      data-i18n="contact.headline"
    >
      HAVE A PROJECT IN MIND?
    </h2>

    <!-- Subcopy -->
    <p
      class="mt-4 text-[14.5px] sm:text-[16px] text-[#6b7280] dark:text-[#a1a1aa] max-w-[520px] mx-auto leading-[1.6] font-normal tracking-[-0.01em]"
      data-i18n="contact.description"
    >
      Together, we can create something clear and impactful. Let's collaborate to bring your ideas to life in a way that resonates with everyone.
    </p>

    <!-- Primary Dark Pill Button (Contact Me ↗) -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${personalInfo.email}`}
        class="group inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-[#18181b] dark:bg-white text-white dark:text-[#18181b] text-[14px] font-medium tracking-[-0.01em] shadow-[0_12px_28px_rgba(0,0,0,0.22)] hover:scale-[1.03] active:scale-[0.98] transition-all"
      >
        <span data-i18n="contact.cta">Contact Me</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >
          <path d="M7 7h10v10" />
          <path d="M7 17 17 7" />
        </svg>
      </a>

      <a
        href={personalInfo.resumeUrl}
        target="_blank"
        download
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-black/[0.08] dark:border-white/[0.12] bg-white/90 dark:bg-[#141416] text-[14px] font-medium text-[#18181b] dark:text-white hover:bg-[#18181b] hover:text-white dark:hover:bg-white dark:hover:text-[#18181b] transition-colors"
      >
        <span data-i18n="download.cv">Download CV</span>
      </a>
    </div>

    <!-- Direct Contact Links Row -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-[13.5px] text-[#52525b] dark:text-[#a1a1aa]">
      <a href={`mailto:${personalInfo.email}`} class="hover:text-[#18181b] dark:hover:text-white transition-colors">
        {personalInfo.email}
      </a>
      <span class="opacity-30">•</span>
      <a href={`tel:${personalInfo.phone}`} class="hover:text-[#18181b] dark:hover:text-white transition-colors">
        {personalInfo.phone}
      </a>
      <span class="opacity-30">•</span>
      <span>{personalInfo.location}</span>
    </div>
  </div>
</section>
