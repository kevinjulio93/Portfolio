---
import { skills } from "../data/portfolio";
---

<section id="skills" class="py-32 relative bg-gradient-to-b from-muted/30 to-muted/10">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 animate-slide-up">
      <span class="text-xs font-medium text-primary uppercase tracking-widest" data-i18n="skills.section">Habilidades</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-4">
        <span data-i18n="skills.title">Tech Stack</span>
      </h2>
    </div>

    <!-- Categories -->
    {["Frontend", "Backend", "DevOps", "Lenguaje"].map((cat) => {
      const catKey = cat === "Lenguaje" ? "skills.cat.language" : `skills.cat.${cat.toLowerCase()}`;
      return (
      <div class="mb-10 stagger-children">
        <h3 class="text-sm font-medium text-muted-foreground mb-4 uppercase tracking-wider" data-i18n={catKey}>{cat}</h3>
        <div class="flex flex-wrap gap-3">
          {skills.filter((s) => s.category === cat).map((skill) => (
            <div class="group px-5 py-3 rounded-2xl border border-border/50 bg-background/50 hover:bg-background hover:border-primary/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_20px_hsl(var(--primary)/0.12)]">
              <span class="inline-flex items-center gap-2 text-sm font-medium text-foreground/80 group-hover:text-foreground transition-colors">
                {skill.name === "React" && <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2" fill="#61DAFB"/><ellipse cx="12" cy="12" rx="8" ry="3" fill="none" stroke="#61DAFB" stroke-width="0.7" transform="rotate(0 12 12)"/><ellipse cx="12" cy="12" rx="8" ry="3" fill="none" stroke="#61DAFB" stroke-width="0.7" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="8" ry="3" fill="none" stroke="#61DAFB" stroke-width="0.7" transform="rotate(120 12 12)"/></svg>}
                {skill.name === "Angular" && <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 2 2 7 4 18 12 22 20 18 22 7Z" fill="#DD0031" opacity="0.15"/><path d="M12 2 2 7l2 11 8 4 8-4 2-11Z" stroke="#DD0031" stroke-width="0.8" fill="none"/><path d="M9 9h6l-3 8" stroke="#DD0031" stroke-width="1" fill="none"/></svg>}
                {skill.name === "TypeScript" && <svg width="18" height="18" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="3" fill="#3178C6"/><path d="M7 16h10" stroke="#fff" stroke-width="1.2" fill="none"/><path d="M12 8v8" stroke="#fff" stroke-width="1.2" fill="none"/></svg>}
                {skill.name === "JavaScript" && <svg width="18" height="18" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="3" fill="#F7DF1E"/><path d="M9 11v7" stroke="#000" stroke-width="1.2" fill="none"/><path d="M7 9v4" stroke="#000" stroke-width="1.2" fill="none"/></svg>}
                {skill.name === "Python" && <svg width="18" height="18" viewBox="0 0 24 24"><path d="M11 3h4v3" fill="none" stroke="#3776AB" stroke-width="1"/><path d="M11 21H7v-3" fill="none" stroke="#FFD43B" stroke-width="1"/><rect x="3" y="9" width="18" height="6" rx="1.5" fill="#3776AB" opacity="0.15"/></svg>}
                {skill.name === "HTML & CSS" && <svg width="18" height="18" viewBox="0 0 24 24"><path d="M4 3l2 16 6 2 6-2 2-16H4Z" fill="#E34F26" opacity="0.15"/><path d="M4 3l2 16 6 2 6-2 2-16H4Z" stroke="#E34F26" stroke-width="0.8" fill="none"/><path d="M9 8h6" stroke="#E34F26" stroke-width="1" fill="none"/><path d="M8.5 12H16" stroke="#E34F26" stroke-width="1" fill="none"/></svg>}
                {skill.name === "Node.js" && <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 2 2 7v10l10 5 10-5V7Z" fill="#339933" opacity="0.12"/><path d="M12 2 2 7v10l10 5 10-5V7Z" stroke="#339933" stroke-width="0.8" fill="none"/><path d="M12 22V12" stroke="#339933" stroke-width="1" fill="none"/></svg>}
                {skill.name === "Docker" && <svg width="18" height="18" viewBox="0 0 24 24"><rect x="4" y="9" width="3" height="3" rx="0.5" fill="#2496ED"/><rect x="8" y="9" width="3" height="3" rx="0.5" fill="#2496ED"/><rect x="12" y="9" width="3" height="3" rx="0.5" fill="#2496ED"/><rect x="8" y="5" width="3" height="3" rx="0.5" fill="#2496ED"/><rect x="12" y="5" width="3" height="3" rx="0.5" fill="#2496ED"/><rect x="16" y="9" width="3" height="3" rx="0.5" fill="#2496ED"/><path d="M3 14c0 2.5 1.5 4 4 4H17c2.5 0 4-1.8 4-4 0-1.5-.8-2.5-2.5-2.5H3Z" fill="#2496ED" opacity="0.1"/></svg>}
                {skill.name === "Kubernetes" && <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="#326CE5" opacity="0.06"/><circle cx="12" cy="12" r="9" stroke="#326CE5" stroke-width="0.6" fill="none"/><circle cx="12" cy="12" r="2.5" fill="none" stroke="#326CE5" stroke-width="1"/><path d="M12 5v3" stroke="#326CE5" stroke-width="0.8" fill="none"/><path d="M12 16v3" stroke="#326CE5" stroke-width="0.8" fill="none"/><path d="M5 12h3" stroke="#326CE5" stroke-width="0.8" fill="none"/><path d="M16 12h3" stroke="#326CE5" stroke-width="0.8" fill="none"/></svg>}
                {skill.name === "Linux" && <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="6" r="2" fill="#FCC624"/><path d="M8 14s4-1.5 8 0" stroke="#FCC624" stroke-width="0.8" fill="none"/><path d="M6.5 18c1.5-2 3.5-3 5.5-3s4 1 5.5 3" stroke="#FCC624" stroke-width="0.8" fill="none"/></svg>}
                {skill.name === "Bash" && <svg width="18" height="18" viewBox="0 0 24 24"><path d="M5 16l5-5-5-5" stroke="#4EAA25" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 19h6" stroke="#4EAA25" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>}
                {skill.name === "Nginx" && <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 3 3 8v8l9 5 9-5V8Z" fill="#009639" opacity="0.1"/><path d="M12 3 3 8v8l9 5 9-5V8Z" stroke="#009639" stroke-width="0.8" fill="none"/><path d="M8 15V9l4 3v3" stroke="#009639" stroke-width="1" fill="none"/></svg>}
                {skill.name === "CI/CD" && <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.1"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="0.7" fill="none"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>}
                {skill.name === "Redux" && <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="#764ABC" opacity="0.1"/><circle cx="12" cy="12" r="9" stroke="#764ABC" stroke-width="0.7" fill="none"/><path d="M12 8v4l2 2" stroke="#764ABC" stroke-width="1" fill="none" stroke-linecap="round"/></svg>}
                {skill.name === "StencilJS" && <svg width="18" height="18" viewBox="0 0 24 24"><polygon points="13,3 4,13 12,13 11,21 20,11 12,11" fill="#5561E5" opacity="0.1"/><polygon points="13,3 4,13 12,13 11,21 20,11 12,11" stroke="#5561E5" stroke-width="0.8" fill="none"/></svg>}
                {skill.name}
              </span>
            </div>
          ))}
        </div>
      </div>
      );
    })}
  </div>
</section>