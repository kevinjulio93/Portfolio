---
import { skills } from "../data/portfolio";
import { skillIcons } from "../data/skillIcons";
---

<section id="skills" class="py-32 relative bg-gradient-to-b from-muted/30 to-muted/10">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 animate-slide-up">
      <span class="text-xs font-medium text-primary uppercase tracking-widest" data-i18n="skills.section">Habilidades</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-4">
        <span data-i18n="skills.title">Tech Stack</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-5 gap-8 items-start">
      <!-- Skills content - left side (3/5) -->
      <div class="md:col-span-3">
        {["Frontend", "Backend", "DevOps", "Lenguaje"].map((cat) => {
          const catKey = cat === "Lenguaje" ? "skills.cat.language" : `skills.cat.${cat.toLowerCase()}`;
          return (
          <div class="mb-10 stagger-children">
            <h3 class="text-sm font-medium text-muted-foreground mb-4 uppercase tracking-wider" data-i18n={catKey}>{cat}</h3>
            <div class="flex flex-wrap gap-3">
              {skills.filter((s) => s.category === cat).map((skill) => (
                <div class="skill-tag group px-5 py-3 rounded-2xl border border-border/50 bg-background/50 hover:bg-background hover:border-primary/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_20px_hsl(var(--primary)/0.12)]">
                  <span class="inline-flex items-center gap-2 text-sm font-medium text-foreground/80 group-hover:text-foreground transition-colors">
                    <span set:html={skillIcons[skill.name] || ''} />
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
          );
        })}
      </div>

      <!-- Photo - right side (2/5) -->
      <div class="md:col-span-2 flex justify-center md:justify-end">
        <div class="skill-photo relative w-full">
          <div class="absolute" />
          <img
            src="/kevin.png"
            alt="Kevin Julio"
            class="relative w-full h-auto rounded-2xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>