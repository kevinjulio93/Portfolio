---
import { personalInfo } from "../data/portfolio";
---

<section
  id="hero"
  class="relative w-full h-[calc(100svh-64px)] sm:h-[calc(100svh-76px)] 2xl:h-[calc(100svh-88px)] min-h-[540px] flex flex-col justify-between px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-24 pt-1 sm:pt-4 pb-0 overflow-hidden border-b border-black/[0.06] dark:border-white/[0.08]"
>
  <div class="w-full max-w-[2240px] mx-auto flex-1 flex flex-col justify-between relative h-full">
    <!-- Giant Split Name: Stacked Full-Width on Mobile, Full-Bleed Single Line on Desktop & Ultra-Wide -->
    <div class="hero-title-wrap relative z-10 text-center pt-0 sm:pt-2 select-none">
      <h1
        class="font-display font-extrabold uppercase tracking-[0.02em] sm:tracking-[0.025em] leading-[0.84] sm:leading-[0.86] text-[20.5vw] sm:text-[clamp(3.2rem,11.2vw,19rem)] flex flex-col sm:flex-row items-center justify-center sm:gap-[0.22em] whitespace-nowrap"
      >
        <span class="hero-word-outline hero-outline-word inline-block">
          {personalInfo.firstName}
        </span>
        <span class="hero-word-solid hero-solid-word inline-block">
          {personalInfo.lastName}
        </span>
      </h1>
    </div>

    <!-- Center Cutout Portrait Anchored to Bottom of Hero Stage -->
    <div
      class="absolute inset-x-0 bottom-[88px] sm:bottom-0 z-10 flex justify-center pointer-events-none select-none"
    >
      <div
        id="hero-portrait-stage"
        class="relative h-[min(60svh,470px)] sm:h-[min(68svh,540px)] md:h-[min(76svh,720px)] 2xl:h-[min(79svh,900px)] aspect-[544/647] pointer-events-auto"
      >
        <!-- Grayscale Editorial Base Portrait -->
        <img
          src="/kevin.png"
          alt={personalInfo.name}
          class="w-full h-full object-contain object-bottom block grayscale contrast-[1.08] brightness-[1.02]"
          loading="eager"
        />
        <!-- Natural Color Spotlight Layer Masked by Cursor Position -->
        <img
          id="hero-portrait-color"
          src="/kevin.png"
          alt=""
          aria-hidden="true"
          class="portrait-color-layer absolute inset-0 w-full h-full object-contain object-bottom pointer-events-none contrast-[1.05] saturate-[1.35] brightness-[1.03]"
          loading="eager"
        />
        <!-- Subtle tactile spotlight cursor dot (from Video 00:03) -->
        <div
          id="portrait-cursor-dot"
          class="hidden md:block pointer-events-none absolute w-3.5 h-3.5 rounded-full bg-white/90 shadow-[0_2px_10px_rgba(0,0,0,0.25)] -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-300"
          style="left: 49%; top: 26%;"
        />
      </div>
    </div>

    <!-- Bottom-Left Role, Bio & Collaborate Pill + Bottom-Right Social Pill Stack -->
    <div
      class="relative md:absolute md:inset-x-0 md:bottom-9 2xl:bottom-14 z-30 mt-auto -mx-4 px-4 sm:mx-0 sm:px-0 flex flex-col md:flex-row md:items-end justify-between gap-3 sm:gap-6 pb-4 sm:pb-6 md:pb-0 pt-14 md:pt-0 bg-gradient-to-t from-[#fdfdfd] from-55% via-[#fdfdfd]/95 via-80% to-transparent dark:from-[#0e0e10] dark:from-55% dark:via-[#0e0e10]/95 dark:via-80% md:bg-none pointer-events-none"
    >
      <!-- Bottom-Left Editorial Copy -->
      <div class="max-w-full md:max-w-[390px] 2xl:max-w-[460px] pointer-events-auto hero-left-block">
        <div class="flex items-center justify-between gap-3 md:block">
          <div>
            <h2
              class="text-[18px] sm:text-[23px] lg:text-[27px] 2xl:text-[32px] font-semibold tracking-[-0.03em] text-[#18181b] dark:text-white leading-[1.15]"
              data-i18n="hero.role"
            >
              Senior Frontend & Full Stack
            </h2>
            <p
              class="mt-1 sm:mt-2.5 text-[12.5px] sm:text-[14px] 2xl:text-[16px] text-[#6b7280] dark:text-[#a1a1aa] leading-[1.45] sm:leading-[1.55] font-normal tracking-[-0.01em] max-w-[330px] 2xl:max-w-[400px] line-clamp-2 md:line-clamp-none"
              data-i18n="hero.bio"
            >
              Designing and engineering digital products, analytics platforms, and multi-agent systems that are clear, usable, and conversion focused.
            </p>
          </div>

          <!-- Mobile Collaborate CTA inline on small viewports to save vertical space -->
          <a
            href="#contact"
            class="md:hidden shrink-0 inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-[#18181b] dark:bg-white text-white dark:text-[#18181b] text-[12px] font-medium tracking-[-0.01em] shadow-[0_8px_20px_rgba(0,0,0,0.18)]"
          >
            <span data-i18n="hero.cta.collaborate">Let's collaborate</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>

        <div class="hidden md:block mt-6 2xl:mt-8">
          <a
            href="#contact"
            class="group inline-flex items-center gap-2.5 px-6 py-3 2xl:px-7 2xl:py-3.5 rounded-full bg-[#18181b] dark:bg-white text-white dark:text-[#18181b] text-[13.5px] 2xl:text-[15px] font-medium tracking-[-0.01em] shadow-[0_10px_26px_rgba(0,0,0,0.2)] hover:scale-[1.03] active:scale-[0.98] transition-all"
          >
            <span data-i18n="hero.cta.collaborate">Let's collaborate</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >
              <path d="M7 7h10v10" />
              <path d="M7 17 17 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Bottom-Right Social Pill Stack (4-col compact bar on mobile, vertical stack on desktop/ultra-wide) -->
      <div class="grid grid-cols-4 md:flex md:flex-col gap-1.5 sm:gap-2.5 pointer-events-auto hero-right-block">
        <a
          href={personalInfo.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full md:w-[148px] 2xl:w-[168px] py-2 md:py-2.5 2xl:py-3 px-2 md:px-4 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white/95 dark:bg-[#141416] text-[#18181b] dark:text-[#f4f4f5] text-[11.5px] md:text-[13px] 2xl:text-[14px] font-medium tracking-[-0.01em] inline-flex items-center justify-center gap-1.5 md:gap-2.5 hover:bg-[#18181b] hover:text-white hover:border-[#18181b] dark:hover:bg-white dark:hover:text-[#18181b] transition-all shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
        >
          <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span class="truncate">GitHub</span>
        </a>

        <a
          href={personalInfo.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full md:w-[148px] 2xl:w-[168px] py-2 md:py-2.5 2xl:py-3 px-2 md:px-4 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white/95 dark:bg-[#141416] text-[#18181b] dark:text-[#f4f4f5] text-[11.5px] md:text-[13px] 2xl:text-[14px] font-medium tracking-[-0.01em] inline-flex items-center justify-center gap-1.5 md:gap-2.5 hover:bg-[#18181b] hover:text-white hover:border-[#18181b] dark:hover:bg-white dark:hover:text-[#18181b] transition-all shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
        >
          <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="3"/><path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 0 0-4 0"/></svg>
          <span class="truncate">LinkedIn</span>
        </a>

        <a
          href={personalInfo.resumeUrl}
          target="_blank"
          class="w-full md:w-[148px] 2xl:w-[168px] py-2 md:py-2.5 2xl:py-3 px-2 md:px-4 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white/95 dark:bg-[#141416] text-[#18181b] dark:text-[#f4f4f5] text-[11.5px] md:text-[13px] 2xl:text-[14px] font-medium tracking-[-0.01em] inline-flex items-center justify-center gap-1.5 md:gap-2.5 hover:bg-[#18181b] hover:text-white hover:border-[#18181b] dark:hover:bg-white dark:hover:text-[#18181b] transition-all shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
        >
          <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
          <span class="truncate">Resume</span>
        </a>

        <a
          href={`mailto:${personalInfo.email}`}
          class="w-full md:w-[148px] 2xl:w-[168px] py-2 md:py-2.5 2xl:py-3 px-2 md:px-4 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white/95 dark:bg-[#141416] text-[#18181b] dark:text-[#f4f4f5] text-[11.5px] md:text-[13px] 2xl:text-[14px] font-medium tracking-[-0.01em] inline-flex items-center justify-center gap-1.5 md:gap-2.5 hover:bg-[#18181b] hover:text-white hover:border-[#18181b] dark:hover:bg-white dark:hover:text-[#18181b] transition-all shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
        >
          <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2.5"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span class="truncate">Email</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive B&W-to-Color Spotlight on Portrait (Shot 1 Video 00:02-00:03)
  const heroSection = document.getElementById('hero');
  const portraitStage = document.getElementById('hero-portrait-stage');
  const colorLayer = document.getElementById('hero-portrait-color');
  const cursorDot = document.getElementById('portrait-cursor-dot');

  if (heroSection && portraitStage && colorLayer) {
    let targetX = 49;
    let targetY = 26;
    let currentX = 49;
    let currentY = 26;
    let rafId: number | null = null;

    function animateSpotlight() {
      currentX += (targetX - currentX) * 0.14;
      currentY += (targetY - currentY) * 0.14;

      colorLayer!.style.setProperty('--spot-x', `${currentX.toFixed(2)}%`);
      colorLayer!.style.setProperty('--spot-y', `${currentY.toFixed(2)}%`);

      if (cursorDot) {
        cursorDot.style.left = `${currentX.toFixed(2)}%`;
        cursorDot.style.top = `${currentY.toFixed(2)}%`;
      }

      if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
        rafId = requestAnimationFrame(animateSpotlight);
      } else {
        rafId = null;
      }
    }

    heroSection.addEventListener(
      'mousemove',
      (e: MouseEvent) => {
        const rect = portraitStage.getBoundingClientRect();
        const relX = ((e.clientX - rect.left) / rect.width) * 100;
        const relY = ((e.clientY - rect.top) / rect.height) * 100;

        // Clamp softly around portrait bounds so spotlight stays active near face/shoulders
        targetX = Math.max(8, Math.min(92, relX));
        targetY = Math.max(8, Math.min(92, relY));

        if (cursorDot) {
          const insidePortrait = relX >= 5 && relX <= 95 && relY >= 5 && relY <= 95;
          cursorDot.style.opacity = insidePortrait ? '1' : '0';
        }

        if (!rafId) {
          rafId = requestAnimationFrame(animateSpotlight);
        }
      },
      { passive: true }
    );

    heroSection.addEventListener(
      'touchmove',
      (e: TouchEvent) => {
        if (!e.touches[0]) return;
        const rect = portraitStage.getBoundingClientRect();
        const relX = ((e.touches[0].clientX - rect.left) / rect.width) * 100;
        const relY = ((e.touches[0].clientY - rect.top) / rect.height) * 100;
        targetX = Math.max(8, Math.min(92, relX));
        targetY = Math.max(8, Math.min(92, relY));
        if (!rafId) {
          rafId = requestAnimationFrame(animateSpotlight);
        }
      },
      { passive: true }
    );

    heroSection.addEventListener(
      'mouseleave',
      () => {
        // Return smoothly to the natural face spotlight position from Shot 1
        targetX = 49;
        targetY = 26;
        if (cursorDot) cursorDot.style.opacity = '0';
        if (!rafId) {
          rafId = requestAnimationFrame(animateSpotlight);
        }
      },
      { passive: true }
    );
  }
</script>
