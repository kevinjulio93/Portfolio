---
import { references, personalInfo } from "../data/portfolio";
---

<section
  id="references"
  class="relative w-full px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-24 pt-16 sm:pt-28 pb-16 border-b border-black/[0.06] dark:border-white/[0.08] overflow-hidden"
>
  <div class="max-w-[2240px] mx-auto grid lg:grid-cols-12 gap-10 2xl:gap-16 items-start">
    <!-- Left Column: About & Approach (Inspired by Shot 2 ABOUT ME layout) -->
    <div class="lg:col-span-7">
      <span
        class="text-[12px] font-medium uppercase tracking-[0.06em] text-[#71717a]"
        data-i18n="about.label"
      >
        ABOUT ME
      </span>
      <p
        class="mt-4 text-[22px] sm:text-[28px] md:text-[32px] font-medium tracking-[-0.03em] text-[#18181b] dark:text-white leading-[1.28]"
        data-i18n="about.bio"
      >
        I'm Kevin Julio, a Senior Frontend & Full Stack Engineer with 10+ years helping product companies and engineering teams turn complex architectures into simple, fast, and scalable digital platforms.
      </p>
      <p class="mt-4 text-[14.5px] text-[#71717a] dark:text-[#a1a1aa] leading-[1.65] max-w-[620px]">
        {personalInfo.location} · {personalInfo.education.degree} ({personalInfo.education.university})
      </p>
    </div>

    <!-- Right Column: Verified Colleague References -->
    <div class="lg:col-span-5 space-y-3.5">
      <span
        class="block text-[12px] font-medium uppercase tracking-[0.06em] text-[#71717a] mb-3"
        data-i18n="references.subtitle"
      >
        Verified professional references
      </span>
      {references.map((ref) => (
        <div class="p-5 rounded-[14px] bg-[#f9fafb] dark:bg-[#141416] border border-black/[0.05] dark:border-white/[0.07] flex items-center justify-between gap-4">
          <div>
            <p class="text-[16px] font-semibold tracking-[-0.02em] text-[#18181b] dark:text-white">
              {ref.name}
            </p>
            <p class="text-[13px] text-[#71717a] dark:text-[#a1a1aa] mt-0.5">{ref.role}</p>
          </div>
          <div class="flex items-center gap-2">
            <a
              href={`mailto:${ref.email}`}
              class="px-3.5 py-1.5 rounded-full border border-[#e5e7eb] dark:border-white/[0.1] bg-white dark:bg-[#1c1c1f] text-[12px] font-medium text-[#18181b] dark:text-[#e4e4e7] hover:bg-[#18181b] hover:text-white dark:hover:bg-white dark:hover:text-[#18181b] transition-colors"
            >
              Email
            </a>
            <a
              href={`tel:${ref.phone}`}
              class="px-3.5 py-1.5 rounded-full border border-[#e5e7eb] dark:border-white/[0.1] bg-white dark:bg-[#1c1c1f] text-[12px] font-medium text-[#18181b] dark:text-[#e4e4e7] hover:bg-[#18181b] hover:text-white dark:hover:bg-white dark:hover:text-[#18181b] transition-colors"
            >
              Call
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
