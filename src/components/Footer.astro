---
import { personalInfo } from "../data/portfolio";
---

<footer class="bg-[#111113] text-white overflow-hidden">
  <!-- Derek® (Shot 2) Editorial Marquee Bar -->
  <div class="py-5 border-b border-white/[0.08] overflow-hidden select-none">
    <div class="animate-editorial-marquee items-center">
      {[0, 1].map(() => (
        <div class="flex items-center gap-8 px-4 text-[18px] sm:text-[22px] font-normal tracking-[-0.025em] text-white/90 whitespace-nowrap">
          <span data-i18n="hero.marquee.1">Conversion-Focused Engineering</span>
          <span class="w-2 h-2 rounded-full bg-white/80 shrink-0" />
          <span data-i18n="hero.marquee.2">Quality Over Quantity</span>
          <span class="w-2 h-2 rounded-full bg-white/80 shrink-0" />
          <span data-i18n="hero.marquee.3">AI-First SDLC & Agentic Workflows</span>
          <span class="w-2 h-2 rounded-full bg-white/80 shrink-0" />
          <span data-i18n="hero.marquee.4">Available Worldwide</span>
          <span class="w-2 h-2 rounded-full bg-white/80 shrink-0" />
        </div>
      ))}
    </div>
  </div>

  <!-- Minimalist Bottom Bar -->
  <div class="max-w-[2240px] mx-auto px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-24 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] 2xl:text-[14px] text-[#a1a1aa]">
    <div class="flex items-center gap-2">
      <span class="font-semibold text-white tracking-[-0.02em]">Kevin Julio®</span>
      <span>—</span>
      <span data-i18n="footer.rights">All rights reserved.</span>
    </div>

    <div class="flex items-center gap-6">
      <a
        href={personalInfo.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors"
      >
        GitHub
      </a>
      <a
        href={personalInfo.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors"
      >
        LinkedIn
      </a>
      <a
        href={`mailto:${personalInfo.email}`}
        class="hover:text-white transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>
