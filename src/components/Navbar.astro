---
---

<header class="w-full h-[64px] sm:h-[76px] 2xl:h-[88px] flex items-center px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-24 relative z-40">
  <div class="w-full max-w-[2240px] mx-auto flex items-center justify-between gap-2 sm:gap-4">
    <!-- Left: Status Pill (Exact match to Shot 1, compact on mobile) -->
    <a
      href="#contact"
      class="inline-flex items-center gap-2 sm:gap-2.5 px-3 sm:px-4 py-1.5 sm:py-2 2xl:px-5 2xl:py-2.5 rounded-full bg-white dark:bg-[#18181b] border border-black/[0.05] dark:border-white/[0.08] shadow-[0_8px_24px_rgba(0,0,0,0.06)] dark:shadow-[0_8px_24px_rgba(0,0,0,0.45)] text-[11.5px] sm:text-[13px] 2xl:text-[14px] font-medium tracking-[-0.01em] text-[#18181b] dark:text-[#f4f4f5] hover:scale-[1.01] transition-transform max-w-[195px] sm:max-w-none truncate"
    >
      <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#22c55e] shrink-0" />
      <span class="truncate" data-i18n="nav.available">Available for New Project</span>
    </a>

    <!-- Center: Navigation Links with Sans-Serif Bracket Counts -->
    <nav class="hidden lg:flex items-center gap-10 xl:gap-12 2xl:gap-16 text-[14px] 2xl:text-[15.5px] tracking-[-0.015em]" aria-label="Primary">
      <a
        href="#projects"
        class="nav-link inline-flex items-baseline gap-1 text-[#18181b] dark:text-[#f4f4f5] font-medium hover:opacity-65 transition-opacity"
      >
        <span data-i18n="nav.work">Work</span>
        <span class="text-[#9ca3af] dark:text-[#71717a] font-normal text-[12.5px]">[04]</span>
      </a>
      <a
        href="#skills"
        class="nav-link inline-flex items-baseline gap-1 text-[#18181b] dark:text-[#f4f4f5] font-medium hover:opacity-65 transition-opacity"
      >
        <span data-i18n="nav.service">Service</span>
        <span class="text-[#9ca3af] dark:text-[#71717a] font-normal text-[12.5px]">[04]</span>
      </a>
      <a
        href="#experience"
        class="nav-link inline-flex items-baseline gap-1 text-[#18181b] dark:text-[#f4f4f5] font-medium hover:opacity-65 transition-opacity"
      >
        <span data-i18n="nav.experience">Experience</span>
        <span class="text-[#9ca3af] dark:text-[#71717a] font-normal text-[12.5px]">[10y+]</span>
      </a>
      <a
        href="#contact"
        class="nav-link text-[#18181b] dark:text-[#f4f4f5] font-medium hover:opacity-65 transition-opacity"
        data-i18n="nav.contact"
      >
        Contact
      </a>
    </nav>

    <!-- Right: Lang + Theme + Let's Talk CTA Pill -->
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
      <button
        id="lang-btn"
        type="button"
        class="h-8 sm:h-9 2xl:h-10 px-2.5 sm:px-3 2xl:px-3.5 rounded-full border border-black/[0.07] dark:border-white/[0.1] bg-white/80 dark:bg-[#18181b] text-[11.5px] sm:text-[12px] 2xl:text-[13px] font-semibold tracking-[-0.01em] text-[#18181b] dark:text-[#f4f4f5] hover:bg-[#18181b] hover:text-white dark:hover:bg-white dark:hover:text-[#18181b] transition-colors cursor-pointer"
        aria-label="Toggle language"
      >
        EN
      </button>

      <button
        id="theme-btn"
        type="button"
        class="w-8 h-8 sm:w-9 sm:h-9 2xl:w-10 2xl:h-10 rounded-full border border-black/[0.07] dark:border-white/[0.1] bg-white/80 dark:bg-[#18181b] flex items-center justify-center text-[#18181b] dark:text-[#f4f4f5] hover:bg-[#18181b] hover:text-white dark:hover:bg-white dark:hover:text-[#18181b] transition-colors cursor-pointer"
        aria-label="Toggle color theme"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <a
        href="#contact"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 2xl:px-6 2xl:py-3 rounded-full bg-[#18181b] dark:bg-white text-white dark:text-[#18181b] text-[13px] 2xl:text-[14px] font-medium tracking-[-0.01em] shadow-[0_8px_20px_rgba(0,0,0,0.18)] hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        <span data-i18n="nav.letsTalk">Let's Talk</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-black/[0.07] dark:border-white/[0.1] bg-white dark:bg-[#18181b] flex items-center justify-center text-[#18181b] dark:text-[#f4f4f5]"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden absolute left-4 right-4 top-[62px] z-50 p-5 rounded-2xl bg-white dark:bg-[#141416] border border-black/[0.06] dark:border-white/[0.08] shadow-2xl"
  >
    <div class="flex flex-col gap-3.5 text-[15px] font-medium">
      <a href="#projects" class="flex items-center justify-between py-1 text-[#18181b] dark:text-[#f4f4f5]">
        <span data-i18n="nav.work">Work</span>
        <span class="text-[#9ca3af] text-[13px] font-normal">[04]</span>
      </a>
      <a href="#skills" class="flex items-center justify-between py-1 text-[#18181b] dark:text-[#f4f4f5]">
        <span data-i18n="nav.service">Service</span>
        <span class="text-[#9ca3af] text-[13px] font-normal">[04]</span>
      </a>
      <a href="#experience" class="flex items-center justify-between py-1 text-[#18181b] dark:text-[#f4f4f5]">
        <span data-i18n="nav.experience">Experience</span>
        <span class="text-[#9ca3af] text-[13px] font-normal">[10y+]</span>
      </a>
      <a href="#contact" class="py-1 text-[#18181b] dark:text-[#f4f4f5]" data-i18n="nav.contact">Contact</a>
    </div>
  </div>
</header>

<script>
  import { getEffectiveTheme, setTheme } from '../scripts/theme';
  import { getLang, setLang } from '../scripts/i18n';

  const themeBtn = document.getElementById('theme-btn');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');

  function syncThemeIcon() {
    const active = getEffectiveTheme();
    if (active === 'dark') {
      iconSun?.classList.remove('hidden');
      iconMoon?.classList.add('hidden');
    } else {
      iconMoon?.classList.remove('hidden');
      iconSun?.classList.add('hidden');
    }
  }

  syncThemeIcon();

  themeBtn?.addEventListener('click', () => {
    const current = getEffectiveTheme();
    setTheme(current === 'dark' ? 'light' : 'dark');
    syncThemeIcon();
  });

  window.addEventListener('theme-changed', syncThemeIcon);

  const langBtn = document.getElementById('lang-btn');
  function syncLangBtn(lang: string) {
    if (langBtn) langBtn.textContent = lang.toUpperCase();
  }

  syncLangBtn(getLang());

  langBtn?.addEventListener('click', () => {
    const next = getLang() === 'es' ? 'en' : 'es';
    setLang(next);
    syncLangBtn(next);
  });

  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
