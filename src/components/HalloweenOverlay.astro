---
// HalloweenOverlay.astro
---

<div id="halloween-root" class="pointer-events-none select-none">
  <!-- Blood Moon Halo behind portrait -->
  <div class="hw-blood-moon"></div>

  <!-- Geometric Cobweb SVG Top Right -->
  <svg class="hw-cobweb" viewBox="0 0 200 200" fill="none" stroke="#ff7a33" stroke-width="1">
    <path d="M200 0 L0 40 M200 0 L20 110 M200 0 L75 170 M200 0 L150 200"></path>
    <path d="M165 7 Q152 24 170 42 Q180 50 200 45"></path>
    <path d="M125 15 Q108 52 135 84 Q158 105 200 95"></path>
    <path d="M80 24 Q60 80 100 130 Q140 160 200 150"></path>
    <path d="M35 33 Q15 105 75 170 Q125 192 200 190"></path>
  </svg>

  <!-- Volumetric Mist / Fog Layer at Base -->
  <div class="hw-fog-layer"></div>

  <!-- Interactive Lantern Ring that tracks cursor over portrait -->
  <div id="hw-lantern" class="hw-lantern-ring" style="left: 49%; top: 28%;"></div>

  <!-- Embers & Minimalist Bats FX Layer -->
  <div id="hw-fx-layer" class="absolute inset-0 pointer-events-none z-25 overflow-hidden">
    <!-- Bats -->
    <svg viewBox="0 0 40 20" class="hw-bat" style="left: 22%; top: 18%; width: 38px; height: 19px; transform: rotate(-12deg);">
      <path d="M2 10 Q8 2 14 8 Q18 3 20 7 Q22 3 26 8 Q32 2 38 10 Q30 9 25 14 Q20 11 15 14 Q10 9 2 10 Z"></path>
    </svg>
    <svg viewBox="0 0 40 20" class="hw-bat" style="left: 27%; top: 13%; width: 27px; height: 14px; transform: rotate(-6deg); animation-delay: -1s;">
      <path d="M2 10 Q8 2 14 8 Q18 3 20 7 Q22 3 26 8 Q32 2 38 10 Q30 9 25 14 Q20 11 15 14 Q10 9 2 10 Z"></path>
    </svg>
    <svg viewBox="0 0 40 20" class="hw-bat" style="left: 74%; top: 22%; width: 35px; height: 18px; transform: rotate(10deg); animation-delay: -1.8s;">
      <path d="M2 10 Q8 2 14 8 Q18 3 20 7 Q22 3 26 8 Q32 2 38 10 Q30 9 25 14 Q20 11 15 14 Q10 9 2 10 Z"></path>
    </svg>
    <svg viewBox="0 0 40 20" class="hw-bat" style="left: 68%; top: 15%; width: 23px; height: 12px; transform: rotate(15deg); animation-delay: -0.6s;">
      <path d="M2 10 Q8 2 14 8 Q18 3 20 7 Q22 3 26 8 Q32 2 38 10 Q30 9 25 14 Q20 11 15 14 Q10 9 2 10 Z"></path>
    </svg>

    <!-- Embers -->
    <span class="hw-ember" style="left: 32%; bottom: 18%; width: 6px; height: 6px; animation-duration: 4.2s;"></span>
    <span class="hw-ember" style="left: 41%; bottom: 12%; width: 4px; height: 4px; animation-duration: 3.6s; animation-delay: -1.2s;"></span>
    <span class="hw-ember" style="left: 46%; bottom: 25%; width: 7px; height: 7px; animation-duration: 4.8s; animation-delay: -2s;"></span>
    <span class="hw-ember" style="left: 54%; bottom: 20%; width: 5px; height: 5px; animation-duration: 3.9s; animation-delay: -0.7s;"></span>
    <span class="hw-ember" style="left: 61%; bottom: 14%; width: 6px; height: 6px; animation-duration: 4.4s; animation-delay: -2.8s;"></span>
    <span class="hw-ember" style="left: 67%; bottom: 22%; width: 4px; height: 4px; animation-duration: 3.4s; animation-delay: -1.5s;"></span>
  </div>
</div>

<script>
  function setupHalloween() {
    document.documentElement.classList.add('halloween-mode');

    // Mount elements into #hero and #hero-portrait-stage
    const hero = document.getElementById('hero');
    const stage = document.getElementById('hero-portrait-stage');
    const root = document.getElementById('halloween-root');
    const lantern = document.getElementById('hw-lantern');

    if (!hero || !root) return;

    // Move root children into hero so they are placed correctly relative to hero
    while (root.firstChild) {
      const child = root.firstChild;
      if (child.id === 'hw-lantern' && stage) {
        stage.appendChild(child);
      } else {
        hero.appendChild(child);
      }
    }

    // Add Navbar Seasonal Badge
    const statusPill = document.querySelector('header a[href="#contact"]');
    if (statusPill && !document.getElementById('hw-seasonal-pill')) {
      const dot = statusPill.querySelector('span');
      if (dot) {
        dot.className = 'w-2.5 h-2.5 rounded-full bg-[#ff5e1a] shadow-[0_0_12px_#ff5e1a] shrink-0';
      }
      const badge = document.createElement('div');
      badge.id = 'hw-seasonal-pill';
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ff5e1a]/15 border border-[#ff5e1a]/35 text-[#ff8a4c] dark:text-[#ff9d66] text-[11px] font-semibold tracking-[-0.01em] shadow-[0_0_18px_rgba(255,94,26,0.18)] shrink-0';
      badge.innerHTML = '<span>🎃</span><span>Halloween 2026</span>';
      statusPill.parentElement?.insertBefore(badge, statusPill.nextElementSibling);
    }

    // Sync lantern with cursor if stage exists
    if (stage && lantern) {
      stage.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = stage.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        lantern.style.left = `${x}%`;
        lantern.style.top = `${y}%`;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHalloween);
  } else {
    setupHalloween();
  }
</script>
