---
import { projects } from "../data/portfolio";
---

<section
  id="projects"
  class="relative w-full px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-24 py-16 sm:py-24 2xl:py-32 border-b border-black/[0.06] dark:border-white/[0.08] overflow-hidden"
>
  <div class="max-w-[2240px] mx-auto">
  <!-- Watermark + /SELECTED WORK Heading (Exact Match to Shot 1 Image 2) -->
  <div class="relative text-center select-none pt-2 pb-8 sm:pb-14">
    <div
      class="watermark-text text-[clamp(2.5rem,11.5vw,13.5rem)] leading-none tracking-[0.03em] sm:tracking-[0.04em] truncate"
      aria-hidden="true"
      data-i18n="projects.watermark"
    >
      PORTFOLIO
    </div>
    <h2
      class="relative z-10 -mt-4 sm:-mt-11 md:-mt-16 text-[clamp(1.65rem,4.2vw,3.8rem)] font-medium tracking-[-0.03em] text-[#18181b] dark:text-white"
      data-i18n="projects.slashTitle"
    >
      /SELECTED WORK
    </h2>
  </div>

  <!-- Filter Row + View All Work Pill -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-10 sm:mb-12">
    <div class="flex items-center gap-6 sm:gap-8 text-[14px] tracking-[-0.015em]" role="tablist">
      <button
        type="button"
        data-filter="all"
        class="work-filter-btn font-semibold text-[#18181b] dark:text-white transition-colors cursor-pointer"
        data-i18n="projects.filter.all"
      >
        All
      </button>
      <button
        type="button"
        data-filter="real"
        class="work-filter-btn font-normal text-[#71717a] hover:text-[#18181b] dark:hover:text-white transition-colors cursor-pointer"
        data-i18n="projects.filter.real"
      >
        Real Project
      </button>
      <button
        type="button"
        data-filter="exploration"
        class="work-filter-btn font-normal text-[#71717a] hover:text-[#18181b] dark:hover:text-white transition-colors cursor-pointer"
        data-i18n="projects.filter.exploration"
      >
        Exploration
      </button>
    </div>

    <a
      href="https://github.com/kevinjulio93"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white dark:bg-[#141416] text-[13px] font-medium tracking-[-0.01em] text-[#18181b] dark:text-[#f4f4f5] hover:bg-[#18181b] hover:text-white hover:border-[#18181b] dark:hover:bg-white dark:hover:text-[#18181b] transition-all shadow-[0_2px_10px_rgba(0,0,0,0.02)]"
    >
      <span data-i18n="projects.viewAll">View All Work</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        <path d="M7 7h10v10" />
        <path d="M7 17 17 7" />
      </svg>
    </a>
  </div>

  <!-- 2x2 Editorial Project Grid (Exact Match to Shot 1 Image 2, scales on Ultra-Wide) -->
  <div id="work-grid" class="grid md:grid-cols-2 gap-6 sm:gap-8 lg:gap-10 2xl:gap-12">
    {projects.map((project, pIdx) => (
      <article
        class="project-card group rounded-[16px] 2xl:rounded-[20px] p-3 sm:p-4 2xl:p-5 bg-[#f9fafb] dark:bg-[#141416] border border-black/[0.04] dark:border-white/[0.06] shadow-[0_14px_38px_rgba(0,0,0,0.035)] hover:shadow-[0_24px_54px_rgba(0,0,0,0.08)] transition-all duration-500 cursor-pointer flex flex-col justify-between"
        data-category={project.category}
        data-project-index={pIdx}
      >
        <!-- Thumbnail Container -->
        <div class="relative aspect-[16/11] w-full rounded-[10px] overflow-hidden bg-[#111113]">
          <img
            src={project.image}
            alt={project.title}
            class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
            loading="lazy"
          />

          <!-- Subtle dark hover veil -->
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 pointer-events-none" />

          <!-- Top-Left Pill Badge (REAL PROJECT / EXPLORATION) -->
          <span class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full bg-white/95 text-[#18181b] text-[10px] font-semibold tracking-[0.04em] uppercase shadow-sm">
            {project.categoryLabel}
          </span>

          <!-- Center Floating Circular Arrow Button on Hover (Exact Match to Shot 1 Image 2) -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <span class="w-12 h-12 rounded-full bg-white text-[#18181b] shadow-[0_12px_30px_rgba(0,0,0,0.28)] flex items-center justify-center scale-90 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </span>
          </div>
        </div>

        <!-- Card Copy & Bottom Pills -->
        <div class="pt-5 pb-1.5 px-1.5 flex-1 flex flex-col justify-between">
          <h3
            class="text-[19px] sm:text-[21px] font-medium tracking-[-0.025em] text-[#18181b] dark:text-white leading-[1.32] group-hover:opacity-80 transition-opacity"
            data-i18n={`proj.${pIdx}.title`}
          >
            {project.title}
          </h3>

          <div class="flex flex-wrap items-center gap-2 mt-4">
            {project.pills.map((pill) => (
              <span class="px-4 py-1.5 rounded-full border border-[#e5e7eb] dark:border-white/[0.1] bg-white dark:bg-[#1c1c1f] text-[12.5px] font-normal tracking-[-0.01em] text-[#18181b] dark:text-[#e4e4e7]">
                {pill}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
  </div>

  <!-- Case Study Slide-Up Detail Sheet (Exact Match to Shot 1 Video 00:17-00:20) -->
  <div
    id="project-detail-drawer"
    class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 md:p-10 bg-black/45 backdrop-blur-md opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-project-title"
  >
    <div
      id="project-detail-sheet"
      class="w-full max-w-[1220px] max-h-[90vh] overflow-y-auto rounded-[20px] bg-[#fdfdfd] dark:bg-[#111113] border border-black/[0.08] dark:border-white/[0.1] shadow-[0_32px_90px_rgba(0,0,0,0.32)] p-6 sm:p-10 md:p-14 translate-y-6 transition-transform duration-300"
    >
      <!-- Top Bar: <- Back button + Status Pill -->
      <div class="flex items-center justify-between gap-4 pb-10 border-b border-black/[0.06] dark:border-white/[0.08]">
        <button
          id="close-project-drawer"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white dark:bg-[#18181b] text-[13px] font-medium text-[#18181b] dark:text-white hover:bg-[#18181b] hover:text-white dark:hover:bg-white dark:hover:text-[#18181b] transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          <span data-i18n="projects.back">Back</span>
        </button>

        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white dark:bg-[#18181b] border border-black/[0.06] dark:border-white/[0.08] shadow-sm text-[12.5px] font-medium text-[#18181b] dark:text-white">
          <span class="w-2 h-2 rounded-full bg-[#22c55e]" />
          <span data-i18n="nav.available">Available for New Project</span>
        </div>
      </div>

      <!-- Case Study Header Grid (Video 00:18 layout) -->
      <div class="grid lg:grid-cols-12 gap-10 py-10 items-start">
        <div class="lg:col-span-7">
          <div id="drawer-pills" class="flex flex-wrap gap-2 mb-5" />
          <div class="flex flex-wrap items-baseline gap-3">
            <h3
              id="drawer-project-title"
              class="text-[32px] sm:text-[44px] font-semibold tracking-[-0.035em] text-[#18181b] dark:text-white leading-[1.08]"
            />
            <span
              id="drawer-project-category"
              class="text-[20px] sm:text-[24px] font-normal text-[#9ca3af] tracking-[-0.02em]"
            />
          </div>
          <p
            id="drawer-project-desc"
            class="mt-5 text-[15px] sm:text-[16px] text-[#52525b] dark:text-[#a1a1aa] leading-[1.65] max-w-[600px]"
          />

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              id="drawer-live-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#18181b] dark:bg-white text-white dark:text-[#18181b] text-[13.5px] font-medium shadow-[0_8px_22px_rgba(0,0,0,0.18)] hover:opacity-90 transition-all"
            >
              <span data-i18n="projects.livePreview">Live Preview</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
            <a
              id="drawer-contact-link"
              href="#contact"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white dark:bg-[#18181b] text-[#18181b] dark:text-white text-[13.5px] font-medium hover:bg-[#f4f4f5] dark:hover:bg-[#27272a] transition-colors"
              data-i18n="projects.contactMe"
            >
              Contact Me
            </a>
          </div>
        </div>

        <!-- Right Metadata Column -->
        <div class="lg:col-span-5 lg:pl-8 lg:border-l border-black/[0.06] dark:border-white/[0.08] space-y-6">
          <div>
            <p class="text-[12px] uppercase tracking-[0.04em] text-[#9ca3af]" data-i18n="projects.meta.role">Service / Role</p>
            <p id="drawer-project-role" class="text-[16px] font-medium text-[#18181b] dark:text-white mt-1" />
          </div>
          <div>
            <p class="text-[12px] uppercase tracking-[0.04em] text-[#9ca3af]" data-i18n="projects.meta.timeline">Timeline</p>
            <p id="drawer-project-period" class="text-[16px] font-medium text-[#18181b] dark:text-white mt-1" />
          </div>
          <div>
            <p class="text-[12px] uppercase tracking-[0.04em] text-[#9ca3af] mb-2.5" data-i18n="projects.meta.stack">Tech Stack</p>
            <div id="drawer-project-tags" class="flex flex-wrap gap-2" />
          </div>
        </div>
      </div>

      <!-- Case Study Visual Showcase (Video 00:19) -->
      <div class="mt-4 rounded-[16px] overflow-hidden border border-black/[0.06] dark:border-white/[0.08] bg-[#111113]">
        <img
          id="drawer-project-image"
          src="/projects/qrvey.jpg"
          alt=""
          class="w-full h-auto max-h-[540px] object-cover object-top"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { projects } from "../data/portfolio";
  import { getLang } from "../scripts/i18n";
  import { t, type TranslationKey } from "../i18n/translations";

  // 1. Category Filter Tabs
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".work-filter-btn");
  const projectCards = document.querySelectorAll<HTMLElement>(".project-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.dataset.filter || "all";

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle("font-semibold", active);
        b.classList.toggle("text-[#18181b]", active);
        b.classList.toggle("dark:text-white", active);
        b.classList.toggle("font-normal", !active);
        b.classList.toggle("text-[#71717a]", !active);
      });

      projectCards.forEach((card) => {
        const cat = card.dataset.category;
        if (selected === "all" || cat === selected) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    });
  });

  // 2. Case Study Detail Drawer (Shot 1 Video 00:17-00:20)
  const drawer = document.getElementById("project-detail-drawer");
  const sheet = document.getElementById("project-detail-sheet");
  const closeBtn = document.getElementById("close-project-drawer");
  const contactLink = document.getElementById("drawer-contact-link");

  const titleEl = document.getElementById("drawer-project-title");
  const catEl = document.getElementById("drawer-project-category");
  const descEl = document.getElementById("drawer-project-desc");
  const roleEl = document.getElementById("drawer-project-role");
  const periodEl = document.getElementById("drawer-project-period");
  const pillsEl = document.getElementById("drawer-pills");
  const tagsEl = document.getElementById("drawer-project-tags");
  const imgEl = document.getElementById("drawer-project-image") as HTMLImageElement | null;
  const liveLink = document.getElementById("drawer-live-link") as HTMLAnchorElement | null;

  function openProjectDrawer(index: number) {
    const proj = projects[index];
    if (!proj || !drawer || !sheet) return;
    const lang = getLang();

    if (titleEl) titleEl.textContent = proj.subtitle;
    if (catEl) catEl.textContent = proj.category === "real" ? "/Real Project" : "/Exploration";
    if (descEl) {
      const longKey = `proj.${index}.long` as TranslationKey;
      descEl.textContent = t(longKey, lang) || proj.longDescription;
    }
    if (roleEl) roleEl.textContent = proj.role;
    if (periodEl) periodEl.textContent = proj.period;
    if (imgEl) {
      imgEl.src = proj.image;
      imgEl.alt = proj.title;
    }
    if (liveLink) {
      liveLink.href = proj.demoUrl || proj.githubUrl || "#contact";
    }
    if (pillsEl) {
      pillsEl.innerHTML = proj.pills
        .map(
          (p) =>
            `<span class="px-3.5 py-1 rounded-full border border-[#e5e7eb] dark:border-white/[0.12] bg-white dark:bg-[#18181b] text-[12px] font-medium text-[#18181b] dark:text-[#e4e4e7]">${p}</span>`
        )
        .join("");
    }
    if (tagsEl) {
      tagsEl.innerHTML = proj.tags
        .map(
          (tag) =>
            `<span class="px-3 py-1 rounded-full bg-[#f4f4f5] dark:bg-[#1c1c1f] text-[12px] font-medium text-[#18181b] dark:text-[#d4d4d8]">${tag}</span>`
        )
        .join("");
    }

    drawer.classList.remove("hidden");
    drawer.classList.add("flex");
    requestAnimationFrame(() => {
      drawer.classList.remove("opacity-0");
      sheet.classList.remove("translate-y-6");
    });
    document.body.style.overflow = "hidden";
  }

  function closeProjectDrawer() {
    if (!drawer || !sheet) return;
    drawer.classList.add("opacity-0");
    sheet.classList.add("translate-y-6");
    setTimeout(() => {
      drawer.classList.remove("flex");
      drawer.classList.add("hidden");
      document.body.style.overflow = "";
    }, 260);
  }

  projectCards.forEach((card) => {
    card.addEventListener("click", () => {
      const idx = Number(card.dataset.projectIndex || 0);
      openProjectDrawer(idx);
    });
  });

  closeBtn?.addEventListener("click", closeProjectDrawer);
  contactLink?.addEventListener("click", closeProjectDrawer);
  drawer?.addEventListener("click", (e) => {
    if (e.target === drawer) closeProjectDrawer();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeProjectDrawer();
  });
</script>
