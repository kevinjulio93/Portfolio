---
import { projects } from "../data/portfolio";
---

<section id="projects" class="py-32 relative">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-xs font-medium text-primary uppercase tracking-widest" data-i18n="projects.section">Trabajos</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-4">
        <span data-i18n="projects.title">Proyectos Destacados</span>
      </h2>
      <p class="text-muted-foreground mt-4 max-w-xl mx-auto" data-i18n="projects.description">
        Una selección de los proyectos en los que he trabajado, desde aplicaciones web hasta plataformas escalables.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {projects.filter(p => p.featured).map((project, pIdx) => (
        <a
          href={project.demoUrl || project.githubUrl}
          target="_blank"
          class="project-card group relative overflow-hidden rounded-3xl border border-border/50 bg-gradient-to-br from-background/40 to-background/20 hover:bg-background transition-all duration-500 hover:shadow-[0_8px_40px_hsl(var(--primary)/0.12)] hover:-translate-y-1.5 hover:border-primary/20"
        >
          <!-- Gradient overlay on hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-violet-500/5 to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />

          <div class="aspect-video bg-muted overflow-hidden">
            <img
              src={project.image}
              alt={`Vista previa de ${project.title}`}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-6 relative">
            <h3 class="text-lg font-semibold tracking-tight group-hover:text-primary transition-colors" data-i18n={`proj.${pIdx}.title`}>
              {project.title}
            </h3>
            <p class="text-sm text-muted-foreground mt-2 leading-relaxed" data-i18n={`proj.${pIdx}.desc`}>
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              {project.tags.map((tag) => (
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-secondary/50 text-muted-foreground border border-border/40 group-hover:border-primary/20 transition-colors">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- More projects grid -->
    {projects.filter(p => !p.featured).length > 0 && (
      <div class="mt-16">
        <h3 class="text-xl font-semibold tracking-tight text-center mb-8" data-i18n="projects.more">Más proyectos</h3>
        <div class="grid md:grid-cols-2 gap-6">
          {projects.filter(p => !p.featured).map((project, pIdx) => {
          const idx = projects.filter(p => p.featured).length + pIdx;
          return (
            <a
              href={project.githubUrl || project.demoUrl}
              target="_blank"
              class="group p-6 rounded-2xl border border-border/40 bg-gradient-to-br from-background/20 to-background/10 hover:bg-background hover:border-primary/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_20px_hsl(var(--primary)/0.1)]"
            >
              <div class="flex items-start justify-between mb-3">
                <h4 class="font-medium text-sm group-hover:text-primary transition-colors" data-i18n={`proj.${idx}.title`}>{project.title}</h4>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary transition-colors"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed" data-i18n={`proj.${idx}.desc`}>{project.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {project.tags.map((tag) => (
                  <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-secondary/40 text-muted-foreground group-hover:border-primary/20 transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          );
        })}
        </div>
      </div>
    )}
  </div>
</section>