---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portafolio profesional de Kevin Julio - IT Engineer & Developer especializado en React, TypeScript, Docker y Kubernetes" />
		<title>Kevin Julio | IT Engineer - Developer</title>
		<!-- Blocking script to prevent theme flash -->
		<script is:inline>
			(function() {
				const theme = localStorage.getItem('portfolio-theme') || 'system';
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = theme === 'dark' || (theme === 'system' && prefersDark);
				if (isDark) document.documentElement.classList.add('dark');
			})();
		</script>
	</head>
	<body class="bg-background text-foreground antialiased relative">
		<!-- Cursor follower (glow in dark, shadow in light) -->
		<div id="cursor-glow" class="fixed pointer-events-none z-[9999] w-[300px] h-[300px] rounded-full -translate-x-1/2 -translate-y-1/2 transition-opacity duration-300 hidden md:block" style="opacity: 0;" />

		<slot />
		<script>
			import { initTheme } from '../scripts/theme';
			import { initI18n } from '../scripts/i18n';
			initTheme();
			initI18n();

			// ---- Cursor Glow / Shadow effect ----
			var cursor = document.getElementById('cursor-glow');
			if (cursor) {
				var cursorTimeout;
				var cursorRaf;

				function updateCursorMode() {
					var dark = document.documentElement.classList.contains('dark');
					if (dark) {
						cursor.style.background = 'radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(168, 85, 247, 0.10) 40%, transparent 70%)';
						cursor.style.width = '400px';
						cursor.style.height = '400px';
					} else {
						cursor.style.background = 'radial-gradient(circle, rgba(0, 0, 0, 0.07) 0%, transparent 70%)';
						cursor.style.width = '280px';
						cursor.style.height = '280px';
					}
				}

				function onMouseMove(e) {
					if (cursorRaf) cancelAnimationFrame(cursorRaf);
					cursorRaf = requestAnimationFrame(function () {
						cursor.style.left = e.clientX + 'px';
						cursor.style.top = e.clientY + 'px';
					});
					cursor.style.opacity = '1';
					clearTimeout(cursorTimeout);
					cursorTimeout = setTimeout(function () {
						cursor.style.opacity = '0';
					}, 2000);
				}

				function onMouseLeave() { cursor.style.opacity = '0'; }
				function onMouseEnter() { cursor.style.opacity = '1'; }

				updateCursorMode();

				document.addEventListener('mousemove', onMouseMove, { passive: true });
				document.addEventListener('mouseleave', onMouseLeave, { passive: true });
				document.addEventListener('mouseenter', onMouseEnter, { passive: true });

				window.addEventListener('theme-changed', updateCursorMode);
			}
		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap');

	html {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
	}

	::selection {
		background-color: hsl(var(--primary) / 0.3);
	}

	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: hsl(var(--muted-foreground) / 0.3);
		border-radius: 3px;
	}

	.nav-blur {
		backdrop-filter: saturate(180%) blur(20px);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
	}

	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}
	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Cursor glow */
	#cursor-glow {
		transition: opacity 0.4s ease, background 0.3s ease;
		will-change: transform, left, top;
		z-index: 9999;
		mix-blend-mode: normal;
	}
	:root.dark #cursor-glow {
		mix-blend-mode: screen;
	}

	/* Theme toggle button styles */
	.theme-btn,
	.lang-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 9999px;
		color: hsl(var(--muted-foreground));
		transition: all 0.15s ease;
	}
	.theme-btn:hover,
	.lang-btn:hover {
		color: hsl(var(--foreground));
		background-color: hsl(var(--accent));
	}
	.theme-btn.active,
	.lang-btn.active {
		color: hsl(var(--foreground));
		background-color: hsl(var(--accent));
	}

	/* Theme dropdown */
	.theme-dropdown {
		position: absolute;
		top: 100%;
		right: 0;
		margin-top: 0.5rem;
		padding: 0.375rem;
		border-radius: 0.75rem;
		border: 1px solid hsl(var(--border));
		background-color: hsl(var(--background));
		box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		min-width: 130px;
		opacity: 0;
		pointer-events: none;
		transform: scale(0.95);
		transition: all 0.15s ease;
		transform-origin: top right;
	}
	.theme-dropdown.open {
		opacity: 1;
		pointer-events: auto;
		transform: scale(1);
	}
	.theme-option {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.375rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		color: hsl(var(--muted-foreground));
		transition: all 0.15s ease;
	}
	.theme-option:hover {
		color: hsl(var(--foreground));
		background-color: hsl(var(--accent));
	}
	.theme-option.active {
		color: hsl(var(--foreground));
		background-color: hsl(var(--accent) / 0.6);
	}
</style>
</style>
