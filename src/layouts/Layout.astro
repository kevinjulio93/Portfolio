---
import '../styles/global.css';
import '../styles/halloween.css';
import HalloweenOverlay from '../components/HalloweenOverlay.astro';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Kevin Julio — Senior Frontend & Full Stack Engineer | AI-First SDLC & Agentic Workflows" />
		<title>Kevin Julio — Senior Frontend & Full Stack Engineer</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..900;1,300..900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script is:inline>
			(function() {
				const theme = localStorage.getItem('portfolio-theme') || 'light';
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = theme === 'dark' || (theme === 'system' && prefersDark);
				if (isDark) document.documentElement.classList.add('dark');
				else document.documentElement.classList.remove('dark');
			})();
		</script>
	</head>
	<body class="bg-[#fdfdfd] dark:bg-[#0e0e10] text-foreground antialiased selection:bg-foreground selection:text-background min-h-screen w-full overflow-x-hidden">
		<HalloweenOverlay />
		<slot />
		<script>
			import { initTheme } from '../scripts/theme';
			import { initI18n } from '../scripts/i18n';
			initTheme();
			initI18n();
		</script>
	</body>
</html>

<style is:global>
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: rgba(24, 24, 27, 0.22);
		border-radius: 3px;
	}
	.dark ::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.22);
	}
</style>
